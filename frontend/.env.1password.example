# frontend/.env.1password.example
#
# Optional 1Password-backed env file for the Next.js frontend.
# Safe to commit — every value is a reference (`op://...`).
#
# How to use:
#   1. Copy to `frontend/.env.1password` (gitignored — never committed)
#   2. Keep your existing `frontend/.env.local` with plaintext values untouched
#   3. Choose which to use per-command:
#        • With 1Password:  op run --env-file frontend/.env.1password -- npm run dev
#        • Plain (default): npm run dev   ← reads .env.local automatically
#
# When your trial expires, just stop prefixing with `op run` — Next.js will
# read .env.local as it always has. No file edits required.
#
# Vault: "Tokenization POC - EVM Smart Contracts"
# Items expected:
#   • "WalletConnect Project"  → field "project_id"
#   • "Alchemy Sepolia"        → field "url"
#   • "Etherscan API"          → field "api_key"
#   • "Sepolia Deployment"     → fields "oracle_address", "fund_address"
#
# For Vercel production / preview environments, use the 1Password GitHub Action
# (see .github/workflows/deploy-with-1password.yml) — the runner resolves these
# references at build time, never embedding plaintext secrets in env settings.

NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=op://Tokenization POC - EVM Smart Contracts/WalletConnect Project/project_id
NEXT_PUBLIC_SEPOLIA_RPC_URL=op://Tokenization POC - EVM Smart Contracts/Alchemy Sepolia/url
NEXT_PUBLIC_ETHERSCAN_API_KEY=op://Tokenization POC - EVM Smart Contracts/Etherscan API/api_key
NEXT_PUBLIC_ORACLE_ADDRESS=op://Tokenization POC - EVM Smart Contracts/Sepolia Deployment/oracle_address
NEXT_PUBLIC_FUND_ADDRESS=op://Tokenization POC - EVM Smart Contracts/Sepolia Deployment/fund_address

# UI indicator (literal value, no op:// resolution needed)
# Surfaces a violet "Secrets: 1Password" pill on the live site so anyone
# can see at a glance that this build was assembled via op run.
NEXT_PUBLIC_SECRETS_SOURCE=1password

# WalletConnect Cloud project ID — get one free at https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Deployed contract addresses (filled in after `forge script Deploy`)
NEXT_PUBLIC_ORACLE_ADDRESS=
NEXT_PUBLIC_FUND_ADDRESS=

# Sepolia RPC — Alchemy / Infura / public. Defaults to a public endpoint if unset.
NEXT_PUBLIC_SEPOLIA_RPC_URL=

# Optional — Etherscan API key for the On-Chain events panel. Free at https://etherscan.io/myapikey.
# Without a key the panel still works but falls back to a stricter rate-limited public endpoint.
NEXT_PUBLIC_ETHERSCAN_API_KEY=

# contracts/.env.1password.example
#
# Optional 1Password-backed env file for `forge script` deploys.
# Safe to commit — every value is a reference (`op://...`), not a real secret.
#
# How to use:
#   1. Copy this file to `contracts/.env.1password` (gitignored — never committed)
#   2. Keep your existing `contracts/.env` with plaintext values untouched
#   3. Run `bash scripts/deploy-full.sh` as usual
#
# What the script does automatically:
#   • While your 1Password trial is active AND `op` CLI is signed in →
#     uses `contracts/.env.1password` via `op run` (secrets from vault)
#   • Trial expired / op not installed / not signed in →
#     falls back to plain `contracts/.env`
#   • You never have to edit either file when the trial ends — fully seamless.
#
# Vault: "Tokenization POC - EVM Smart Contracts"
# Items expected in that vault:
#   • "Sepolia Deployer"   → field "private_key"   (0x-prefixed)
#   • "Alchemy Sepolia"    → field "url"           (full https URL with key)
#   • "Etherscan API"      → field "api_key"

PRIVATE_KEY=op://Tokenization POC - EVM Smart Contracts/Sepolia Deployer/private_key
SEPOLIA_RPC_URL=op://Tokenization POC - EVM Smart Contracts/Alchemy Sepolia/url
ETHERSCAN_API_KEY=op://Tokenization POC - EVM Smart Contracts/Etherscan API/api_key

# Pulled from the vault and written into frontend/.env.local on every deploy
# so the live UI's "Connect wallet" button keeps working after each redeploy.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=op://Tokenization POC - EVM Smart Contracts/WalletConnect Project/project_id

# Optional — leave as-is or remove
INITIAL_PRICE=100000
ASSET_NAME=Tokenized Real Estate Fund Series A
